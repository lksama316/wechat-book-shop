/* uni.scss */
.home swiper {
  width: 750rpx;
  height: 380rpx;
}
.home swiper image {
  height: 100%;
  width: 100%;
}
.home .nav {
  display: flex;
}
.home .nav .nav_item {
  width: 25%;
  text-align: center;
}
.home .nav .nav_item image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 20rpx 0;
}
.home .nav .nav_item text {
  font-size: 26rpx;
}
.home .tab_goods .tab {
  display: -webkit-box;
  padding: 20rpx 0;
  border-bottom: 2rpx #f8f8f8 solid;
}
.home .tab_goods .tab ._a {
  display: block;
  -webkit-box-flex: 1;
  border-right: 2rpx #d2d2d2 solid;
  text-align: center;
  color: #BA55D3;
  text-decoration: none;
  outline: 0;
}
.home .tab_goods .tab ._a:last-child {
  border: none;
}
.home .tab_goods .tab .clickStyle {
  color: #ff7d00;
}
.home .tab_goods .goods {
  margin: 20rpx 40rpx;
}
.home .tab_goods .goods image {
  width: 200rpx;
  height: 200rpx;
  float: left;
  z-index: 11;
  position: relative;
  display: block;
  border: 2rpx #f8f8f8 solid;
}
.home .tab_goods .goods .info {
  height: 200rpx;
  position: relative;
}
.home .tab_goods .goods .info .name {
  margin-top: 4rpx;
  margin-left: 246rpx;
}
.home .tab_goods .goods .info .del {
  margin: 12rpx 0;
  margin-left: 246rpx;
  color: grey;
  text-decoration: line-through;
}
.home .tab_goods .goods .info .new {
  margin-left: 246rpx;
  margin-bottom: 12rpx;
  color: #31bd80;
}
.home .tab_goods .goods .info .sellNum {
  margin-left: 246rpx;
  font-size: 28rpx;
  color: grey;
}
.home .tab_goods .goods .info .addToCart {
  position: absolute;
  top: 80rpx;
  right: 20rpx;
  height: 40rpx;
  width: 40rpx;
}

