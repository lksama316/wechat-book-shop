/* uni.scss */
.u-transition {
  background-color: rgba(0, 0, 0, 0.2) !important;
}
page {
  background: #F1F1F1;
}
.address {
  background: #333;
  height: 80rpx;
  overflow: hidden;
  padding: .30rem 3%;
  font-size: .28em;
  color: white;
  position: relative;
}
.address .user {
  margin-right: .60rem;
}
.address .location {
  width: 80%;
}
.address .bg {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  line-height: 1.3rem;
  font-size: 50rpx;
  color: #f4f4f4;
  background: rgba(255, 255, 255, 0.15);
  box-shadow: -2px 0 5px grey;
  width: 3rem;
  -webkit-transform: scaleX(-1);
          transform: scaleX(-1);
}
.address .arrow {
  position: absolute;
  top: 12rpx;
  right: 25rpx;
  font-size: 50rpx;
  color: #f4f4f4;
}
.order {
  color: grey;
  background: white;
  padding: 0 3%;
  margin: 20rpx 0;
}
.order .title {
  border-bottom: 1px #d2d2d2 solid;
  padding: 20rpx 0;
  font-size: 25rpx;
}
.order .product {
  padding: 30rpx 0;
  position: relative;
  height: 130rpx;
}
.order .product image {
  float: left;
  width: 160rpx;
  height: 120rpx;
}
.order .product .name {
  width: 80%;
  margin-top: 50rpx;
  color: #666;
  font-size: 30rpx;
}
.order .product .price {
  position: absolute;
  top: 64rpx;
  right: 20rpx;
  color: #666;
  font-size: 28rpx;
}
.order .product .num {
  position: absolute;
  top: 90rpx;
  right: 20rpx;
  color: #666;
  font-size: 26rpx;
}
.sum {
  background: white;
  width: 100%;
  height: 50rpx;
  position: relative;
}
.sum .price {
  position: absolute;
  right: 10rpx;
  top: 4rpx;
}

