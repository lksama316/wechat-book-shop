/* uni.scss */
page {
  background: #F1F1F1;
}
.photo {
  width: 750rpx;
  height: 546rpx;
  background: #FFFFFF;
}
.info {
  margin-top: 20rpx;
  height: 160rpx;
  background: #FFFFFF;
}
.info .name {
  padding: 20rpx 0rpx 20rpx 30rpx;
}
.info .new-price {
  padding: 0rpx 0rpx 20rpx 20rpx;
  color: #FF0033;
  font-size: 50rpx;
  font-weight: bold;
}
.info .old-price {
  padding-left: 20rpx;
  color: grey;
  text-decoration: line-through;
}
.detail {
  margin-top: 20rpx;
  background: #FFFFFF;
  color: #999;
  font-size: 28rpx;
}
.detail .title {
  padding: 20rpx 0rpx 20rpx 30rpx;
}
.bottom {
  margin-top: 20rpx;
  width: 750rpx;
  background: #FFFFFF;
}

